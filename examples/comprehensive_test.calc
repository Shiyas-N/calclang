// Comprehensive test for all optimizations


var a = 10 + 20;           // Should fold to 30
var b = 5 * 6;             // Should fold to 30
var c = 100 / 2;           // Should fold to 50

print(a);
print(b);
print(c);

// Test 2 Algebraic simplification  
var x = 100;
var y = x + 0;             // Should simplify to x
var z = y * 1;             // Should simplify to y

print(z);

// Test 3 Dead code elimination
var unused1 = 999;         // Should be removed
var unused2 = 42 * 55;     // Should be removed


func fibonacci(n) {
    var temp1 = n * 1;     // Simplifies to n
    var temp2 = temp1 - 0; // Simplifies to temp1
    return temp2;
}

var result = fibonacci(10);
print(result);

// Test 5 Complex expression
var complex = 2 + 3 * 4 - 1;  // Should fold to 13
print(complex);